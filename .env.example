# Copy to .env.local and fill in to enable accounts + cloud saves.
# Leave empty to run in on-device mode (hikes stored in this browser only).
#
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: OAuth providers you enabled under Authentication → Providers (comma-separated)
# VITE_AUTH_PROVIDERS=google,github
